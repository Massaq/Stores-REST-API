# Скопіюй цей файл у .env і встав реальні значення.
# Згенерувати випадковий JWT_SECRET_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=

# Потрібно тільки для запуску БЕЗ docker compose (там ці значення
# вже прописані прямо в docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DATABASE_URL=postgresql://appuser:app_password@localhost:5432/stores_db
